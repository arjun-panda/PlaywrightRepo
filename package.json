{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Playwright TypeScript UI and API automation framework",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.30",
    "dotenv": "^16.4.7",
    "typescript": "^5.9.3"
  }
}
